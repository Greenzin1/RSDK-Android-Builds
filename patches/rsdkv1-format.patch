+int functionStack[0x100];
+int functionStackPos = 0;
+
 // ... existing script engine code ...
 
 void LoadByteCode(char *filename) {
@@ -80,6 +84,18 @@
                     case 0xD6: // SetMusicTrack
                         break;
 
+                    // RSDKv1: KeyDown.Back (Xbox/PS back button)
+                    case 0x9E: // KeyDown.Back
+                        if (inputPress[5]) // Back/Select button
+                            scriptEng->checkResult = true;
+                        else
+                            scriptEng->checkResult = false;
+                        break;
+
                     // ... rest of opcodes ...
                 }
             }
@@ -120,6 +136,13 @@
     }
 }
 
+// RSDKv1: function call/return using functionStack
+void ScriptFunctionCall(int funcNum) {
+    functionStack[functionStackPos++] = scriptDataPtr;
+    scriptDataPtr = functionScriptList[funcNum].mainScript;
+}
+
+void ScriptFunctionReturn() {
+    scriptDataPtr = functionStack[--functionStackPos];
+}
+
 // ... existing code ...

