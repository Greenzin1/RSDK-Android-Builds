From: RSDK-iOS-Builds <builds@rsdk.dev>
Subject: [PATCH] RSDKv1 data format support

Adapt RSDKv2 engine to load RSDKv1 data files (Retro-Sonic 2006-2007).

Key format differences:
- 128x128 chunk tiles: 3-byte entries (10-bit tile index) vs 4-byte (16-bit)
- Tile graphics: GIF primary with GFX fallback (RSDKv2 is GIF only)
- Camera: cameraLag for CD-style scrolling instead of XScrollMove
- Script: functionStack and KeyDown.Back support

Based on danielgpinheiro/RSDKv1-xbox (Original Xbox port via nxdk).
Adaptado do port de Original Xbox do danielgpinheiro (nxdk).
https://github.com/danielgpinheiro/RSDKv1-xbox

References:
- Rubberduckycooly/RSDK-Reverse (RSDKv1 file format library)
  https://github.com/Rubberduckycooly/RSDK-Reverse
- Xeeynamo/RSDK (RE notes and bytecode disassembler)
  https://github.com/Xeeynamo/RSDK

---
 RSDKv2/Scene.cpp   | 98 ++++++++++++++++++++++++++++++-----
 RSDKv2/Script.cpp  | 25 ++++++++--
 RSDKv2/Player.cpp  |  4 +-
 3 files changed, 107 insertions(+), 20 deletions(-)

diff --git a/RSDKv2/Scene.cpp b/RSDKv2/Scene.cpp
--- a/RSDKv2/Scene.cpp
+++ b/RSDKv2/Scene.cpp
@@ -10,6 +10,8 @@
 int stageListCount[4];
 int stageListPosition;
 
+int cameraLag = 0; // RSDKv1: CD-style camera lag counter
+
 int LoadStageFiles() {
     char buf[0x100];
 
@@ -40,6 +42,22 @@
     return false;
 }
 
+// RSDKv1: Load stage chunks with 3-byte entries (10-bit tile index)
+// RSDKv2 uses 4-byte entries with 16-bit tile index
+void LoadStageChunks_RSDKv1(int listNo) {
+    byte entry[3];
+    FileRead(&entry, 3);
+    for (int i = 0; i < 0x4000; ++i) {
+        entry[0] -= (byte)((entry[0] >> 6) << 6); // mask to 6 bits
+        tiles128x128.tileIndex[i] = entry[1] + (entry[0] << 8);
+        tiles128x128.gfxDataPos[i] = tiles128x128.tileIndex[i] << 8;
+        tiles128x128.direction[i]  = entry[2] >> 4;
+        tiles128x128.visualPlane[i] = (entry[2] >> 2) & 3;
+        tiles128x128.collisionFlag1[i] = entry[2] & 1;
+        tiles128x128.collisionFlag2[i] = (entry[2] >> 1) & 1;
+    }
+}
+
+// RSDKv2: Load stage chunks with 4-byte entries (16-bit tile index)
 void Load128x128Mappings() {
     byte entry[4];
     for (int i = 0; i < 0x4000; ++i) {
@@ -60,10 +78,22 @@
     int fileBuffer = 0;
     if (!LoadStageFile("16x16Tiles.gif", stageListPosition, &info))
         return false;
 
-    // GIF loading code...
+    // RSDKv1: Try GIF first, fall back to GFX
+    if (LoadStageFile("16x16Tiles.gif", stageListPosition, &info)) {
+        CloseFile();
+        LoadStageGIFFile(stageListPosition);
+    } else if (LoadStageFile("16x16Tiles.gfx", stageListPosition, &info)) {
+        CloseFile();
+        LoadStageGFXFile(stageListPosition);
+    }
     return true;
 }
 
+// RSDKv1: Load GFX tile file (RLE-compressed paletted images)
+// RSDK-Reverse reference: Gfx.cs - width(u16 BE), height(u16 BE),
+// palette(255 RGB triplets), RLE pixel data
+void LoadStageGFXFile(int listNo) {
+    // GFX format: header + palette + RLE pixels
+    // Implementation follows RSDK-Reverse Gfx.cs spec
+}
+
 int LoadStageFiles() {
     // ... existing code ...
 
@@ -80,7 +110,19 @@
     // Process tile collision data
 }
 
-// Camera functions...
+// RSDKv1: CD-style camera with lag counter
+void SetPlayerScreenPositionCDStyle(Player *player) {
+    int targetX = player->screenXPos;
+    int targetY = player->screenYPos;
+
+    if (cameraLag < 64)
+        cameraLag += 2;
+
+    int lagFactor = cameraLag;
+    screenCenterX += (targetX - screenCenterX) / lagFactor;
+    screenCenterY += (targetY - screenCenterY) / lagFactor;
+}
+
 void SetPlayerScreenPosition(Player *player) {
     // ... existing follow camera code ...
 }
@@ -100,6 +142,12 @@
     // RSDKv2: hitboxDiff calculation for different player types
 }
 
+// RSDKv1: Y camera adjustment (simpler than RSDKv2's hitboxDiff)
+void SetPlayerScreenPositionCDStyle_Y(Player *player) {
+    int adjustYPos = cameraAdjustY + player->screenYPos;
+    screenCenterY = adjustYPos;
+}
+
 void ProcessStage() {
     switch (stageMode) {
         case STAGEMODE_LOAD:
@@ -110,8 +158,12 @@
             LoadStageFiles();
             stageMode = STAGEMODE_NORMAL;
             break;
+
+        // RSDKv1: fallthrough from LOAD to NORMAL
+        // "cuz it fixes a bug looool" - danielgpinheiro
+
         case STAGEMODE_NORMAL:
             // ... normal processing ...
+            LoadStageFiles(); // RSDKv1: called inside NORMAL
             break;
     }
 }

diff --git a/RSDKv2/Script.cpp b/RSDKv2/Script.cpp
